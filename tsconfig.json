{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/core/**/*.js", "src/state/**/*.js", "src/lib/**/*.js", "src/platform/**/*.js", "src/config/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
